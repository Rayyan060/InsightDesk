# Copy to .env (project root) and adjust. All values are optional; defaults
# are shown. Leaving DATABASE_URL, OLLAMA_BASE_URL or CHROMA_PERSIST_DIR blank
# marks that component "not_configured" in /health.

APP_NAME=InsightDesk
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

# Relative SQLite paths are resolved against the project root.
DATABASE_URL=sqlite:///./data/insightdesk.db

OLLAMA_BASE_URL=http://localhost:11434
# Pick a model that fits your hardware, e.g. qwen2.5:3b or llama3.2:3b on 8 GB RAM.
OLLAMA_MODEL=qwen2.5:7b

CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

LOG_LEVEL=INFO

# --- Optional (defaults shown) ---
# LOG_FORMAT=json                 # json | text
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# MAX_REQUEST_BYTES=65536
# HEALTH_CHECK_TIMEOUT_SECONDS=2
# OLLAMA_TIMEOUT_SECONDS=60
# MAX_CRITIC_REVISIONS=1             # guide R4: at most one revision (0 or 1 allowed)
# SEED_REFERENCE_DATA=true          # load data/reference (plan limits, policy registry) at startup; never overwrites
